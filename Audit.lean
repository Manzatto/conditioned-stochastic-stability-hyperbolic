/-! Check actual private proof axioms. Theorem parameters are audited as hypotheses. -/

open Lean Elab Command in
run_cmd do
  let standard := #[``propext, ``Classical.choice, ``Quot.sound]
  let env ← getEnv
  let mut checked : Nat := 0
  let mut theorems : Nat := 0
  for (name, info) in env.constants.toList do
    if (`ConditionedStochasticStabilityHyperbolic).isPrefixOf name ||
        (`LeanShared).isPrefixOf name ||
        (`AbsorbingMarkovChains).isPrefixOf name ||
        name.toString.startsWith "_private.ConditionedStochasticStabilityHyperbolic." ||
        name.toString.startsWith "_private.LeanShared." ||
        name.toString.startsWith "_private.AbsorbingMarkovChains." then
      match info with
      | .axiomInfo _ => throwError "Project or shared declaration is an axiom: {name}"
      | .thmInfo _ => theorems := theorems + 1
      | _ => pure ()
      for ax in ← collectAxioms name do
        unless standard.contains ax do
          throwError "{name} depends on forbidden axiom {ax}"
      checked := checked + 1
  if theorems == 0 then
    throwError "No theorems found; an empty audit is not verification."
  logInfo m!"Axiom audit passed: {checked} declarations, including {theorems} theorems; only standard classical axioms."
