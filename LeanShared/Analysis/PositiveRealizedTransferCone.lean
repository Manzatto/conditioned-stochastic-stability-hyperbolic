module

public import LeanShared.Analysis.WeightedTransferMatrixCoefficients
public import Mathlib.Topology.ContinuousMap.Bounded.Normed
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.Ring

/-! The closed cone generated by actual nonnegative regular functions is
preserved by the completed nonnegative weighted transfer. Its pairings with
nonnegative physical tests are nonnegative complex numbers, including after
passage to the anisotropic completion. -/

public noncomputable section
open Set MeasureTheory

namespace LeanShared.PositiveRealizedTransferCone

@[expose] def Nonnegative (z : ℂ) : Prop := z.im = 0 ∧ 0 ≤ z.re

theorem isClosed_nonnegative : IsClosed {z : ℂ | Nonnegative z} :=
  (isClosed_eq Complex.continuous_im continuous_const).inter
    (isClosed_le continuous_const Complex.continuous_re)

theorem Nonnegative.ofReal {r : ℝ} (hr : 0 ≤ r) : Nonnegative (r : ℂ) := ⟨rfl, hr⟩

theorem Nonnegative.mul {z w : ℂ} (hz : Nonnegative z) (hw : Nonnegative w) :
    Nonnegative (z * w) := by
  constructor
  · simp only [Complex.mul_im, hz.1, hw.1, mul_zero, zero_mul, zero_add]
  · simpa only [Complex.mul_re, hz.1, hw.1, mul_zero, sub_zero] using
      mul_nonneg hz.2 hw.2

theorem nonnegative_integral {X : Type*} [MeasurableSpace X]
    (μ : Measure X) (f : X → ℂ) (positive : ∀ x, Nonnegative (f x)) :
    Nonnegative (∫ x, f x ∂μ) := by
  have real (x : X) : f x = ((f x).re : ℂ) := by
    apply Complex.ext
    · rfl
    · exact (positive x).1
  rw [show f = (fun x => ((f x).re : ℂ)) from funext real]
  rw [integral_complex_ofReal]
  exact Nonnegative.ofReal (integral_nonneg (fun x => (positive x).2))

variable {X R H : Type*} [NormedAddCommGroup R] [NormedSpace ℂ R]
  [NormedAddCommGroup H] [NormedSpace ℂ H]
  (view : R →ₗ[ℂ] (X → ℂ)) (realize : R →L[ℂ] H)

/-- The closed native cone generated by genuine nonnegative regular inputs. -/
@[expose] def cone : Set H := closure (realize '' {f : R | ∀ x, Nonnegative (view f x)})

theorem isClosed_cone : IsClosed (cone view realize) := isClosed_closure

theorem realize_mem_cone (f : R) (positive : ∀ x, Nonnegative (view f x)) :
    realize f ∈ cone view realize := subset_closure ⟨f, positive, rfl⟩

/-- Positivity of the actual integral pairing survives completion. -/
theorem pairing_nonnegative [MeasurableSpace X] (μ : Measure X)
    (test : X → ℂ) (positiveTest : ∀ x, Nonnegative (test x))
    (pairing : H →L[ℂ] ℂ)
    (identity : ∀ f : R, pairing (realize f) = ∫ x, view f x * test x ∂μ)
    {v : H} (positiveV : v ∈ cone view realize) : Nonnegative (pairing v) := by
  apply closure_minimal (t := {v : H | Nonnegative (pairing v)}) ?_
    (isClosed_nonnegative.preimage pairing.continuous) positiveV
  rintro _ ⟨f, positiveF, rfl⟩
  change Nonnegative (pairing (realize f))
  rw [identity]
  exact nonnegative_integral μ _ (fun x => (positiveF x).mul (positiveTest x))

variable {Ω : Type*} (hview : Function.Injective view) (F : Ω → X → X)
  (g : X → ℝ)
  (hregular : ∀ a f,
    FiniteRegularTransferRealization.weightedComposition (F a) g (view f) ∈ view.range)
  (C : ℝ) (hbound : ∀ a f,
    ‖InvariantFiniteRegularTransfer.action view hview F g hregular a f‖ ≤ C * ‖f‖)

/-- The finite-regular weighted operator preserves literal nonnegativity. -/
theorem regularOperator_nonnegative (a : Ω) (weight : ∀ x, 0 ≤ g x)
    (f : R) (positiveF : ∀ x, Nonnegative (view f x)) :
    ∀ x, Nonnegative (view
      (InvariantFiniteRegularTransfer.operator view hview F g hregular C hbound a f) x) := by
  intro x
  rw [InvariantFiniteRegularTransfer.operator_function]
  exact (Nonnegative.ofReal (weight x)).mul (positiveF (F a x))

/-- The actual completed operator preserves the closed positive cone once
its proved finite-regular intertwining is substituted. -/
theorem mapsTo_cone (P : H →L[ℂ] H) (a : Ω)
    (compatibility : realize.comp
      (InvariantFiniteRegularTransfer.operator view hview F g hregular C hbound a) =
      P.comp realize)
    (weight : ∀ x, 0 ≤ g x) : MapsTo P (cone view realize) (cone view realize) := by
  apply Set.MapsTo.closure ?_ P.continuous
  rintro _ ⟨f, positiveF, rfl⟩
  refine ⟨InvariantFiniteRegularTransfer.operator view hview F g hregular C hbound a f,
    regularOperator_nonnegative view hview F g hregular C hbound a weight f positiveF, ?_⟩
  exact congrArg (fun L : R →L[ℂ] H => L f) compatibility

end LeanShared.PositiveRealizedTransferCone

namespace LeanShared.PositiveTestFunctional
open PositiveRealizedTransferCone
open scoped BoundedContinuousFunction

variable {X Test : Type*} [TopologicalSpace X]
  [NormedAddCommGroup Test] [NormedSpace ℂ Test]

/-- A positive complex functional takes real values on real physical tests. -/
theorem im_eq_zero_of_real
    (physical : Test →L[ℂ] (X →ᵇ ℂ)) (one : Test)
    (one_eq : ∀ x, physical one x = 1) (ℓ : Test →L[ℂ] ℂ)
    (positive : ∀ t : Test, (∀ x, Nonnegative (physical t x)) → Nonnegative (ℓ t))
    (t : Test) (realTest : ∀ x, (physical t x).im = 0) : (ℓ t).im = 0 := by
  let C := ‖physical t‖
  have mass := positive one (fun x => by rw [one_eq]; exact ⟨rfl, zero_le_one⟩)
  have plus : Nonnegative (ℓ ((C : ℂ) • one + t)) := by
    apply positive
    intro x
    rw [map_add, map_smul, BoundedContinuousFunction.add_apply,
      BoundedContinuousFunction.smul_apply, one_eq, smul_eq_mul, mul_one]
    refine ⟨by simp only [Complex.add_im, Complex.ofReal_im, realTest, zero_add], ?_⟩
    have lower := neg_le_of_abs_le
      ((Complex.abs_re_le_norm (physical t x)).trans ((physical t).norm_coe_le_norm x))
    change 0 ≤ C + (physical t x).re
    linarith
  rw [map_add, map_smul, smul_eq_mul] at plus
  simpa only [Complex.add_im, Complex.mul_im, Complex.ofReal_im, mass.1,
    mul_zero, zero_mul, zero_add] using plus.1

/-- Conjugation-closed real tests determine every complex linear functional. -/
theorem eq_of_eq_on_real_tests
    (physical : Test →L[ℂ] (X →ᵇ ℂ))
    (conjugate : Test → Test)
    (conjugate_eq : ∀ t x, physical (conjugate t) x = star (physical t x))
    (f g : Test →ₗ[ℂ] ℂ)
    (agrees : ∀ t, (∀ x, (physical t x).im = 0) → f t = g t) : f = g := by
  ext t
  have real_sum : ∀ x, (physical (t + conjugate t) x).im = 0 := by
    intro x
    simp only [map_add, BoundedContinuousFunction.add_apply, conjugate_eq,
      Complex.add_im, Complex.star_def, Complex.conj_im, add_neg_cancel]
  have real_difference : ∀ x, (physical (Complex.I • (t - conjugate t)) x).im = 0 := by
    intro x
    simp only [map_smul, map_sub, BoundedContinuousFunction.smul_apply,
      BoundedContinuousFunction.sub_apply, conjugate_eq, smul_eq_mul,
      Complex.mul_im, Complex.I_re, Complex.I_im, Complex.sub_re,
      Complex.star_def, Complex.conj_re, sub_self, mul_zero, zero_mul, zero_add]
  have sum_eq := agrees (t + conjugate t) real_sum
  have difference_eq := agrees (Complex.I • (t - conjugate t)) real_difference
  simp only [map_add] at sum_eq
  simp only [map_smul, map_sub, smul_eq_mul] at difference_eq
  have diff_eq := mul_left_cancel₀ Complex.I_ne_zero difference_eq
  have doubled : (2 : ℂ) * f t = 2 * g t := by
    calc
      (2 : ℂ) * f t = (f t + f (conjugate t)) + (f t - f (conjugate t)) := by ring
      _ = (g t + g (conjugate t)) + (g t - g (conjugate t)) := by rw [sum_eq, diff_eq]
      _ = 2 * g t := by ring
  exact mul_left_cancel₀ (by norm_num : (2 : ℂ) ≠ 0) doubled

/-- Positivity makes the pairing with every real test bounded by its physical
supremum norm times total mass. The bound is independent of the stronger test
norm in which the distribution was initially defined. -/
theorem norm_le_mass_mul
    (physical : Test →L[ℂ] (X →ᵇ ℂ)) (one : Test)
    (one_eq : ∀ x, physical one x = 1) (ℓ : Test →L[ℂ] ℂ)
    (positive : ∀ t : Test, (∀ x, Nonnegative (physical t x)) → Nonnegative (ℓ t))
    (t : Test) (realTest : ∀ x, (physical t x).im = 0) :
    ‖ℓ t‖ ≤ ‖physical t‖ * (ℓ one).re := by
  let C := ‖physical t‖
  have mass := positive one (fun x => by rw [one_eq]; exact ⟨rfl, zero_le_one⟩)
  have lower (x : X) : -C ≤ (physical t x).re :=
    (neg_le_of_abs_le ((Complex.abs_re_le_norm _).trans ((physical t).norm_coe_le_norm x)))
  have upper (x : X) : (physical t x).re ≤ C :=
    (le_abs_self _).trans ((Complex.abs_re_le_norm _).trans ((physical t).norm_coe_le_norm x))
  have plus : Nonnegative (ℓ ((C : ℂ) • one + t)) := by
    apply positive
    intro x
    rw [map_add, map_smul, BoundedContinuousFunction.add_apply,
      BoundedContinuousFunction.smul_apply, one_eq, smul_eq_mul, mul_one]
    exact ⟨by simp only [Complex.add_im, Complex.ofReal_im, realTest, zero_add],
      by simpa only [Complex.add_re, Complex.ofReal_re, add_comm] using
        (neg_le_iff_add_nonneg.mp (lower x))⟩
  have minus : Nonnegative (ℓ ((C : ℂ) • one - t)) := by
    apply positive
    intro x
    rw [map_sub, map_smul, BoundedContinuousFunction.sub_apply,
      BoundedContinuousFunction.smul_apply, one_eq, smul_eq_mul, mul_one]
    exact ⟨by simp only [Complex.sub_im, Complex.ofReal_im, realTest, sub_self],
      by simpa only [Complex.sub_re, Complex.ofReal_re] using sub_nonneg.mpr (upper x)⟩
  rw [map_add, map_smul, smul_eq_mul] at plus
  rw [map_sub, map_smul, smul_eq_mul] at minus
  have realValue : (ℓ t).im = 0 := by
    simpa only [Complex.add_im, Complex.mul_im, Complex.ofReal_im, mass.1,
      mul_zero, zero_mul, zero_add] using plus.1
  have lowerValue : -(C * (ℓ one).re) ≤ (ℓ t).re := by
    have h := plus.2
    simp only [Complex.add_re, Complex.mul_re, Complex.ofReal_re,
      Complex.ofReal_im, zero_mul, sub_zero] at h
    linarith
  have upperValue : (ℓ t).re ≤ C * (ℓ one).re := by
    have h := minus.2
    simp only [Complex.sub_re, Complex.mul_re, Complex.ofReal_re,
      Complex.ofReal_im, zero_mul, sub_zero] at h
    exact sub_nonneg.mp h
  have real : ℓ t = ((ℓ t).re : ℂ) := Complex.ext rfl realValue
  rw [real, Complex.norm_real, Real.norm_eq_abs]
  exact abs_le.mpr ⟨lowerValue, upperValue⟩

/-- A positive functional with zero total mass vanishes on all complex
tests when the physical test class is closed under conjugation. -/
theorem eq_zero_of_mass_zero
    (physical : Test →L[ℂ] (X →ᵇ ℂ)) (one : Test)
    (one_eq : ∀ x, physical one x = 1)
    (conjugate : Test → Test)
    (conjugate_eq : ∀ t x, physical (conjugate t) x = star (physical t x))
    (ℓ : Test →L[ℂ] ℂ)
    (positive : ∀ t : Test, (∀ x, Nonnegative (physical t x)) → Nonnegative (ℓ t))
    (mass_zero : (ℓ one).re = 0) : ℓ = 0 := by
  have real_zero (t : Test) (ht : ∀ x, (physical t x).im = 0) : ℓ t = 0 := by
    apply norm_eq_zero.mp
    apply le_antisymm _ (norm_nonneg _)
    simpa only [mass_zero, mul_zero] using norm_le_mass_mul physical one one_eq ℓ positive t ht
  ext t
  have real_sum : ∀ x, (physical (t + conjugate t) x).im = 0 := by
    intro x
    simp only [map_add, BoundedContinuousFunction.add_apply, conjugate_eq,
      Complex.add_im, Complex.star_def, Complex.conj_im, add_neg_cancel]
  have real_difference : ∀ x, (physical (Complex.I • (t - conjugate t)) x).im = 0 := by
    intro x
    simp only [map_smul, map_sub, BoundedContinuousFunction.smul_apply,
      BoundedContinuousFunction.sub_apply, conjugate_eq, smul_eq_mul,
      Complex.mul_im, Complex.I_re, Complex.I_im, Complex.sub_re,
      Complex.star_def, Complex.conj_re, sub_self, mul_zero, zero_mul, zero_add]
  have sum_zero := real_zero (t + conjugate t) real_sum
  have difference_zero := real_zero (Complex.I • (t - conjugate t)) real_difference
  rw [map_add] at sum_zero
  rw [map_smul, map_sub, smul_eq_mul] at difference_zero
  have diff_zero : ℓ t - ℓ (conjugate t) = 0 :=
    (mul_eq_zero.mp difference_zero).resolve_left Complex.I_ne_zero
  change ℓ t = 0
  have doubled : (2 : ℂ) * ℓ t = 0 := by
    calc
      (2 : ℂ) * ℓ t = (ℓ t + ℓ (conjugate t)) + (ℓ t - ℓ (conjugate t)) := by ring
      _ = 0 := by rw [sum_zero, diff_zero, add_zero]
  exact (mul_eq_zero.mp doubled).resolve_left (by norm_num)

end LeanShared.PositiveTestFunctional
