module

public import Mathlib.Probability.Kernel.Basic
public import Mathlib.MeasureTheory.Measure.Prod
public import Mathlib.MeasureTheory.Integral.Bochner.Set

/-!
# Kernels generated by jointly measurable random maps

The noise law is pushed forward by the random map at each starting state.
Joint measurability proves that the resulting family is a measurable kernel.
Restriction to a measurable survival region gives the killed transition.
These results do not assert strong-Feller regularity or a spectral gap.
-/

@[expose] public noncomputable section

open MeasureTheory ProbabilityTheory Set

namespace LeanShared.RandomMapKernel

variable {X Y Ω : Type*} [MeasurableSpace X] [MeasurableSpace Y] [MeasurableSpace Ω]

/-- The law of one random step, with the departure state in the first coordinate. -/
def transition (ρ : Measure Ω) [IsFiniteMeasure ρ] (F : X × Ω → Y)
    (hF : Measurable F) : Kernel X Y where
  toFun x := ρ.map (fun ω => F (x, ω))
  measurable' := Measure.measurable_of_measurable_coe _ fun s hs => by
    change Measurable (fun x : X => (ρ.map (fun ω => F (x, ω))) s)
    have heq : (fun x : X => (ρ.map (fun ω => F (x, ω))) s) =
        (fun x : X => ρ (Prod.mk x ⁻¹' (F ⁻¹' s))) := by
      funext x
      exact Measure.map_apply (hF.comp measurable_prodMk_left) hs
    rw [heq]
    exact measurable_measure_prodMk_left (hs.preimage hF)

@[simp]
theorem transition_apply (ρ : Measure Ω) [IsFiniteMeasure ρ] (F : X × Ω → Y)
    (hF : Measurable F) (x : X) :
    transition ρ F hF x = ρ.map (fun ω => F (x, ω)) := rfl

instance transition_isMarkov (ρ : Measure Ω) [IsProbabilityMeasure ρ]
    (F : X × Ω → Y) (hF : Measurable F) : IsMarkovKernel (transition ρ F hF) := by
  constructor
  intro x
  change IsProbabilityMeasure (ρ.map (fun ω => F (x, ω)))
  infer_instance

/-- The one-step transfer is integration over the original noise parameters. -/
theorem integral_transition (ρ : Measure Ω) [IsFiniteMeasure ρ] (F : X × Ω → Y)
    (hF : Measurable F) (f : Y → ℝ) (hf : Measurable f) (x : X) :
    (∫ y, f y ∂transition ρ F hF x) = ∫ ω, f (F (x, ω)) ∂ρ := by
  rw [transition_apply]
  exact integral_map_of_stronglyMeasurable (hF.comp measurable_prodMk_left)
    hf.stronglyMeasurable

/-- Killing on exit restricts the destination measure to the survival region. -/
def killed (ρ : Measure Ω) [IsFiniteMeasure ρ] (F : X × Ω → Y)
    (hF : Measurable F) (U : Set Y) (hU : MeasurableSet U) : Kernel X Y :=
  (transition ρ F hF).restrict hU

/-- A probability noise law makes this a sub-Markov kernel. -/
theorem killed_mass_le_one (ρ : Measure Ω) [IsProbabilityMeasure ρ]
    (F : X × Ω → Y) (hF : Measurable F) (U : Set Y) (hU : MeasurableSet U) (x : X) :
    killed ρ F hF U hU x univ ≤ 1 := by
  change ((transition ρ F hF x).restrict U) univ ≤ 1
  rw [Measure.restrict_apply MeasurableSet.univ, univ_inter]
  exact prob_le_one

/-- The killed operator has exactly the survival indicator used in the paper. -/
theorem integral_killed (ρ : Measure Ω) [IsFiniteMeasure ρ] (F : X × Ω → Y)
    (hF : Measurable F) (U : Set Y) (hU : MeasurableSet U)
    (f : Y → ℝ) (hf : Measurable f) (x : X) :
    (∫ y, f y ∂killed ρ F hF U hU x) =
      ∫ ω, U.indicator f (F (x, ω)) ∂ρ := by
  change (∫ y, f y ∂(transition ρ F hF x).restrict U) = _
  rw [← integral_indicator hU]
  exact integral_transition ρ F hF _ (hf.indicator hU) x

end LeanShared.RandomMapKernel
